// LAKOO E-Commerce Platform - Clean Slate Schema
// Business Model: Multi-Brand + Advertising Marketplace
// Date: January 2026

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CORE USER & AUTH
// =============================================================================

model users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String?                 @unique @db.VarChar(255)
  phone_number          String                  @unique @db.VarChar(20)
  password_hash         String?
  first_name            String?                 @db.VarChar(100)
  last_name             String?                 @db.VarChar(100)
  profile_image_url     String?
  role                  user_role               @default(buyer)
  status                user_status             @default(active)
  email_verified        Boolean                 @default(false)
  phone_verified        Boolean                 @default(false)
  last_login_at         DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)

  // Relations
  addresses             addresses[]
  orders                orders[]
  payments              payments[]
  cart                  cart[]
  notifications         notifications[]
  product_reviews       product_reviews[]
  wallet                wallet?
  sellers               sellers?
  factories             factories?

  @@index([email], map: "idx_users_email")
  @@index([phone_number], map: "idx_users_phone")
  @@index([role], map: "idx_users_role")
}

model addresses {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  label           String?   @db.VarChar(50)
  recipient_name  String    @db.VarChar(255)
  phone_number    String    @db.VarChar(20)
  street_address  String
  district        String?   @db.VarChar(100)
  city            String    @db.VarChar(100)
  province        String    @db.VarChar(100)
  postal_code     String    @db.VarChar(10)
  country         String    @default("Indonesia") @db.VarChar(100)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  is_default      Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders          orders[]

  @@index([user_id], map: "idx_addresses_user")
}

// =============================================================================
// BRANDS (15 Official LAKOO Brands)
// =============================================================================

model brands {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_code              String          @unique @db.VarChar(50)
  brand_name              String          @db.VarChar(255)
  slug                    String          @unique @db.VarChar(255)

  // Branding
  logo_url                String?         @db.VarChar(500)
  banner_url              String?         @db.VarChar(500)
  primary_color           String?         @default("#000000") @db.VarChar(7)
  secondary_color         String?         @default("#FFFFFF") @db.VarChar(7)

  // Brand Identity
  brand_story             String?
  tagline                 String?         @db.VarChar(255)
  target_audience         String?         @db.VarChar(100)
  style_category          String?         @db.VarChar(100)

  // Pricing Strategy
  default_margin_percent  Decimal?        @default(50.00) @db.Decimal(5, 2)

  // Status
  status                  brand_status    @default(active)
  display_order           Int             @default(0)

  // Timestamps
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  updated_at              DateTime        @default(now()) @db.Timestamptz(6)

  // Relations
  brand_products          brand_products[]
  orders                  orders[]
  order_items             order_items[]

  @@index([slug], map: "idx_brands_slug")
  @@index([status], map: "idx_brands_status")
}

model brand_products {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id              String    @db.Uuid
  product_id            String    @db.Uuid

  // Brand-Specific Pricing
  brand_price           Decimal   @db.Decimal(15, 2)
  brand_compare_price   Decimal?  @db.Decimal(15, 2)
  discount_percent      Decimal?  @db.Decimal(5, 2)

  // Brand-Specific Display
  brand_product_name    String?   @db.VarChar(255)
  brand_description     String?
  display_order         Int       @default(0)

  // Flags
  is_featured           Boolean   @default(false)
  is_bestseller         Boolean   @default(false)
  is_new_arrival        Boolean   @default(false)
  is_active             Boolean   @default(true)

  // Timestamps
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  brands                brands    @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  products              products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([brand_id, product_id])
  @@index([brand_id], map: "idx_brand_products_brand")
  @@index([product_id], map: "idx_brand_products_product")
  @@index([is_featured], map: "idx_brand_products_featured")
  @@index([is_active], map: "idx_brand_products_active")
}

// =============================================================================
// PRODUCTS & CATEGORIES (Warehouse Master Catalog)
// =============================================================================

model categories {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id       String?      @db.Uuid
  name            String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(255)
  description     String?
  image_url       String?
  display_order   Int          @default(0)
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)

  parent          categories?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children        categories[] @relation("CategoryHierarchy")
  products        products[]

  @@index([slug], map: "idx_categories_slug")
  @@index([parent_id], map: "idx_categories_parent")
}

model products {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id                 String                       @db.Uuid
  supplier_id                 String?                      @db.Uuid

  // Basic Info
  sku                         String                       @unique @db.VarChar(100)
  name                        String                       @db.VarChar(255)
  slug                        String                       @unique @db.VarChar(255)
  description                 String?

  // Pricing (Warehouse Transfer Price)
  cost_price                  Decimal                      @db.Decimal(15, 2)

  // Physical Attributes
  weight_grams                Int?
  length_cm                   Decimal?                     @db.Decimal(10, 2)
  width_cm                    Decimal?                     @db.Decimal(10, 2)
  height_cm                   Decimal?                     @db.Decimal(10, 2)

  // Media
  primary_image_url           String?

  // Grosir Configuration
  grosir_unit_size            Int?                         @default(12)

  // Status
  status                      product_status               @default(active)

  // SEO
  meta_title                  String?                      @db.VarChar(255)
  meta_description            String?

  // Timestamps
  published_at                DateTime?                    @db.Timestamptz(6)
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                     @default(now()) @db.Timestamptz(6)

  // Relations
  categories                  categories                   @relation(fields: [category_id], references: [id])
  suppliers                   suppliers?                   @relation(fields: [supplier_id], references: [id])
  product_variants            product_variants[]
  product_images              product_images[]
  product_reviews             product_reviews[]
  brand_products              brand_products[]
  warehouse_inventory         warehouse_inventory[]
  warehouse_purchase_orders   warehouse_purchase_orders[]
  grosir_bundle_config        grosir_bundle_config[]
  grosir_warehouse_tolerance  grosir_warehouse_tolerance[]
  order_items                 order_items[]
  seller_products             seller_products[]

  @@index([category_id], map: "idx_products_category")
  @@index([sku], map: "idx_products_sku")
  @@index([slug], map: "idx_products_slug")
  @@index([status], map: "idx_products_status")
}

model product_variants {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id                  String                       @db.Uuid
  sku                         String                       @unique @db.VarChar(100)
  variant_name                String                       @db.VarChar(255)
  color                       String?                      @db.VarChar(50)
  size                        String?                      @db.VarChar(50)
  material                    String?                      @db.VarChar(100)
  price_adjustment            Decimal?                     @default(0.00) @db.Decimal(15, 2)
  weight_grams                Int?
  image_url                   String?
  is_active                   Boolean                      @default(true)
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                     @default(now()) @db.Timestamptz(6)

  products                    products                     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse_inventory         warehouse_inventory[]
  warehouse_purchase_orders   warehouse_purchase_orders[]
  grosir_bundle_config        grosir_bundle_config[]
  grosir_warehouse_tolerance  grosir_warehouse_tolerance[]
  order_items                 order_items[]

  @@index([product_id], map: "idx_product_variants_product")
  @@index([sku], map: "idx_product_variants_sku")
}

model product_images {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String    @db.Uuid
  image_url     String
  alt_text      String?   @db.VarChar(255)
  display_order Int       @default(0)
  is_primary    Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  products      products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "idx_product_images_product")
}

model product_reviews {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String    @db.Uuid
  user_id         String    @db.Uuid
  order_id        String?   @db.Uuid
  rating          Int
  title           String?   @db.VarChar(255)
  review_text     String?
  images          Json?
  is_verified     Boolean   @default(false)
  helpful_count   Int       @default(0)
  status          review_status @default(pending)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  products        products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders          orders?   @relation(fields: [order_id], references: [id])

  @@index([product_id], map: "idx_reviews_product")
  @@index([user_id], map: "idx_reviews_user")
  @@index([rating], map: "idx_reviews_rating")
}

// =============================================================================
// SUPPLIERS (Factories that supply to warehouse)
// =============================================================================

model suppliers {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_code             String                      @unique @db.VarChar(50)
  supplier_name             String                      @db.VarChar(255)
  contact_person            String?                     @db.VarChar(255)
  email                     String?                     @db.VarChar(255)
  phone_number              String?                     @db.VarChar(20)
  whatsapp_number           String?                     @db.VarChar(20)
  address                   String?
  city                      String?                     @db.VarChar(100)
  postal_code               String?                     @db.VarChar(10)
  status                    supplier_status             @default(active)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)

  products                  products[]
  warehouse_purchase_orders warehouse_purchase_orders[]

  @@index([supplier_code], map: "idx_suppliers_code")
}

// Keep factories for backward compatibility (maps to old factory-service)
model factories {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                  String    @unique @db.Uuid
  factory_name              String    @db.VarChar(255)
  factory_code              String    @unique @db.VarChar(50)
  description               String?
  address                   String?
  city                      String?   @db.VarChar(100)
  province                  String?   @db.VarChar(100)
  postal_code               String?   @db.VarChar(10)
  phone_number              String?   @db.VarChar(20)
  email                     String?   @db.VarChar(255)
  verification_status       verification_status @default(pending)
  status                    factory_status      @default(active)
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime  @default(now()) @db.Timestamptz(6)

  users                     users     @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([factory_code], map: "idx_factories_code")
  @@index([owner_id], map: "idx_factories_owner")
}

// =============================================================================
// WAREHOUSE & GROSIR (CRITICAL - Preserved from old system)
// =============================================================================

model warehouse_inventory {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String            @db.Uuid
  variant_id          String?           @db.Uuid
  quantity            Int               @default(0)
  reserved_quantity   Int               @default(0)
  available_quantity  Int?              @default(dbgenerated("(quantity - reserved_quantity)"))
  location            String?           @db.VarChar(100)
  min_stock_level     Int?              @default(0)
  last_restocked_at   DateTime?         @db.Timestamptz(6)
  last_sold_at        DateTime?         @db.Timestamptz(6)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)

  products            products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants    product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([product_id, variant_id])
  @@index([product_id], map: "idx_warehouse_inventory_product")
}

model warehouse_purchase_orders {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  po_number       String            @unique @db.VarChar(50)
  supplier_id     String?           @db.Uuid
  product_id      String            @db.Uuid
  variant_id      String?           @db.Uuid
  quantity        Int
  unit_cost       Decimal           @db.Decimal(15, 2)
  shipping_cost   Decimal?          @default(0) @db.Decimal(15, 2)
  total_cost      Decimal           @db.Decimal(15, 2)
  status          po_status         @default(pending)
  notes           String?
  expected_at     DateTime?         @db.Timestamptz(6)
  received_at     DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)

  suppliers       suppliers?        @relation(fields: [supplier_id], references: [id])
  products        products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants product_variants? @relation(fields: [variant_id], references: [id])

  @@index([po_number], map: "idx_warehouse_po_number")
  @@index([supplier_id], map: "idx_warehouse_po_supplier")
  @@index([status], map: "idx_warehouse_po_status")
}

// GROSIR Bundle Configuration - units per bundle from supplier
model grosir_bundle_config {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String            @db.Uuid
  variant_id        String?           @db.Uuid
  units_per_bundle  Int
  notes             String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)

  products          products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants  product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([product_id, variant_id], map: "unique_bundle_config")
  @@index([product_id], map: "idx_bundle_config_product")
}

// GROSIR Warehouse Tolerance - max excess units allowed per variant
model grosir_warehouse_tolerance {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id              String            @db.Uuid
  variant_id              String?           @db.Uuid
  max_excess_units        Int
  clearance_rate_estimate Int?
  notes                   String?
  created_at              DateTime          @default(now()) @db.Timestamptz(6)
  updated_at              DateTime          @default(now()) @db.Timestamptz(6)

  products                products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants        product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([product_id, variant_id], map: "unique_tolerance_config")
  @@index([product_id], map: "idx_tolerance_product")
}

// =============================================================================
// THIRD-PARTY SELLERS (0% Commission Marketplace)
// =============================================================================

model sellers {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String          @unique @db.Uuid
  seller_code           String          @unique @db.VarChar(50)
  shop_name             String          @db.VarChar(255)
  shop_slug             String          @unique @db.VarChar(255)
  shop_logo_url         String?
  shop_banner_url       String?
  shop_description      String?

  // Business Info
  business_name         String?         @db.VarChar(255)
  business_license      String?         @db.VarChar(100)
  tax_id                String?         @db.VarChar(100)

  // Bank Info
  bank_name             String?         @db.VarChar(100)
  bank_account_name     String?         @db.VarChar(255)
  bank_account_number   String?         @db.VarChar(50)

  // Commission (0% for marketplace, revenue from ads)
  commission_rate       Decimal         @default(0.00) @db.Decimal(5, 2)

  // Status
  verification_status   verification_status @default(pending)
  status                seller_status       @default(pending)

  // Timestamps
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)

  users                 users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  seller_products       seller_products[]
  seller_inventory      seller_inventory[]
  orders                orders[]
  ad_balance            seller_ad_balance?
  ad_campaigns          ad_campaigns[]

  @@index([seller_code], map: "idx_sellers_code")
  @@index([shop_slug], map: "idx_sellers_slug")
  @@index([status], map: "idx_sellers_status")
}

model seller_products {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id         String    @db.Uuid
  product_id        String?   @db.Uuid

  // If seller creates own product (not from warehouse)
  name              String    @db.VarChar(255)
  slug              String    @unique @db.VarChar(255)
  description       String?
  price             Decimal   @db.Decimal(15, 2)
  compare_price     Decimal?  @db.Decimal(15, 2)
  sku               String?   @db.VarChar(100)

  // Media
  images            Json?

  // Status
  status            product_status @default(active)

  // Timestamps
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  sellers           sellers   @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  products          products? @relation(fields: [product_id], references: [id])
  seller_inventory  seller_inventory[]
  order_items       order_items[]

  @@index([seller_id], map: "idx_seller_products_seller")
  @@index([slug], map: "idx_seller_products_slug")
}

model seller_inventory {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id           String          @db.Uuid
  seller_product_id   String          @db.Uuid
  product_id          String?         @db.Uuid
  quantity            Int             @default(0)
  reserved_quantity   Int             @default(0)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)

  sellers             sellers         @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  seller_products     seller_products @relation(fields: [seller_product_id], references: [id], onDelete: Cascade)
  products            products?       @relation(fields: [product_id], references: [id])

  @@unique([seller_id, seller_product_id])
  @@index([seller_id], map: "idx_seller_inventory_seller")
}

// =============================================================================
// ADVERTISING SYSTEM (Revenue Source for Marketplace)
// =============================================================================

model seller_ad_balance {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id         String    @unique @db.Uuid
  balance           Decimal   @default(0) @db.Decimal(15, 2)
  total_deposited   Decimal   @default(0) @db.Decimal(15, 2)
  total_spent       Decimal   @default(0) @db.Decimal(15, 2)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  sellers           sellers   @relation(fields: [seller_id], references: [id], onDelete: Cascade)
}

model ad_campaigns {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id         String          @db.Uuid
  campaign_name     String          @db.VarChar(255)
  campaign_type     ad_campaign_type

  // Budget
  daily_budget      Decimal         @db.Decimal(15, 2)
  total_budget      Decimal?        @db.Decimal(15, 2)
  spent_today       Decimal         @default(0) @db.Decimal(15, 2)
  spent_total       Decimal         @default(0) @db.Decimal(15, 2)

  // Pricing
  pricing_model     ad_pricing_model
  bid_amount        Decimal         @db.Decimal(10, 2)

  // Targeting
  target_categories String[]        @db.Uuid
  target_keywords   String[]

  // Schedule
  start_date        DateTime        @db.Timestamptz(6)
  end_date          DateTime?       @db.Timestamptz(6)

  // Status
  status            ad_campaign_status @default(draft)

  // Timestamps
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)

  sellers           sellers         @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  ad_campaign_products ad_campaign_products[]
  ad_impressions    ad_impressions[]
  ad_clicks         ad_clicks[]
  ad_conversions    ad_conversions[]

  @@index([seller_id], map: "idx_ad_campaigns_seller")
  @@index([status], map: "idx_ad_campaigns_status")
}

model ad_campaign_products {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id   String        @db.Uuid
  product_id    String        @db.Uuid
  custom_bid    Decimal?      @db.Decimal(10, 2)
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)

  ad_campaigns  ad_campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, product_id])
}

model ad_impressions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id   String        @db.Uuid
  product_id    String?       @db.Uuid
  user_id       String?       @db.Uuid
  placement     String        @db.VarChar(50)
  position      Int?
  cost          Decimal       @default(0) @db.Decimal(10, 4)
  session_id    String?       @db.VarChar(100)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)

  ad_campaigns  ad_campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id], map: "idx_ad_impressions_campaign")
  @@index([created_at], map: "idx_ad_impressions_created")
}

model ad_clicks {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id     String        @db.Uuid
  impression_id   String?       @db.Uuid
  product_id      String?       @db.Uuid
  user_id         String?       @db.Uuid
  cost            Decimal       @db.Decimal(10, 4)
  session_id      String?       @db.VarChar(100)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)

  ad_campaigns    ad_campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id], map: "idx_ad_clicks_campaign")
  @@index([created_at], map: "idx_ad_clicks_created")
}

model ad_conversions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id   String        @db.Uuid
  click_id      String?       @db.Uuid
  order_id      String?       @db.Uuid
  product_id    String?       @db.Uuid
  order_amount  Decimal       @db.Decimal(15, 2)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)

  ad_campaigns  ad_campaigns  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id], map: "idx_ad_conversions_campaign")
}

model banner_ad_slots {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slot_name       String              @unique @db.VarChar(100)
  slot_location   String              @db.VarChar(100)
  width           Int
  height          Int
  price_per_day   Decimal             @db.Decimal(15, 2)
  price_per_week  Decimal?            @db.Decimal(15, 2)
  price_per_month Decimal?            @db.Decimal(15, 2)
  is_active       Boolean             @default(true)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)

  banner_bookings banner_ad_bookings[]
}

model banner_ad_bookings {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slot_id         String          @db.Uuid
  seller_id       String          @db.Uuid
  image_url       String          @db.VarChar(500)
  click_url       String          @db.VarChar(500)
  alt_text        String?         @db.VarChar(255)
  start_date      DateTime        @db.Date
  end_date        DateTime        @db.Date
  total_price     Decimal         @db.Decimal(15, 2)
  payment_status  payment_status  @default(pending)
  status          banner_status   @default(pending)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)

  banner_ad_slots banner_ad_slots @relation(fields: [slot_id], references: [id])

  @@index([slot_id], map: "idx_banner_bookings_slot")
  @@index([start_date, end_date], map: "idx_banner_bookings_dates")
}

// =============================================================================
// ORDERS & PAYMENTS (Simplified - No Escrow)
// =============================================================================

model orders {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number      String          @unique @db.VarChar(50)
  user_id           String          @db.Uuid

  // Order Source (brand or seller)
  brand_id          String?         @db.Uuid
  seller_id         String?         @db.Uuid
  order_source      order_source    @default(brand)

  // Shipping
  shipping_address_id String?       @db.Uuid
  shipping_method   String?         @db.VarChar(100)
  shipping_cost     Decimal         @default(0) @db.Decimal(15, 2)
  tracking_number   String?         @db.VarChar(100)

  // Amounts
  subtotal          Decimal         @db.Decimal(15, 2)
  discount_amount   Decimal         @default(0) @db.Decimal(15, 2)
  total_amount      Decimal         @db.Decimal(15, 2)

  // Status
  status            order_status    @default(pending)

  // Notes
  customer_notes    String?
  internal_notes    String?

  // Timestamps
  paid_at           DateTime?       @db.Timestamptz(6)
  shipped_at        DateTime?       @db.Timestamptz(6)
  delivered_at      DateTime?       @db.Timestamptz(6)
  cancelled_at      DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)

  users             users           @relation(fields: [user_id], references: [id])
  brands            brands?         @relation(fields: [brand_id], references: [id])
  sellers           sellers?        @relation(fields: [seller_id], references: [id])
  addresses         addresses?      @relation(fields: [shipping_address_id], references: [id])
  order_items       order_items[]
  payments          payments[]
  shipments         shipments[]
  refunds           refunds[]
  product_reviews   product_reviews[]

  @@index([order_number], map: "idx_orders_number")
  @@index([user_id], map: "idx_orders_user")
  @@index([brand_id], map: "idx_orders_brand")
  @@index([seller_id], map: "idx_orders_seller")
  @@index([status], map: "idx_orders_status")
  @@index([created_at], map: "idx_orders_created")
}

model order_items {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String            @db.Uuid
  product_id          String?           @db.Uuid
  variant_id          String?           @db.Uuid
  seller_product_id   String?           @db.Uuid
  brand_id            String?           @db.Uuid

  // Product Snapshot
  product_name        String            @db.VarChar(255)
  variant_name        String?           @db.VarChar(255)
  sku                 String?           @db.VarChar(100)
  image_url           String?

  // Pricing
  unit_price          Decimal           @db.Decimal(15, 2)
  quantity            Int
  subtotal            Decimal           @db.Decimal(15, 2)

  // Timestamps
  created_at          DateTime          @default(now()) @db.Timestamptz(6)

  orders              orders            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products            products?         @relation(fields: [product_id], references: [id])
  product_variants    product_variants? @relation(fields: [variant_id], references: [id])
  seller_products     seller_products?  @relation(fields: [seller_product_id], references: [id])
  brands              brands?           @relation(fields: [brand_id], references: [id])

  @@index([order_id], map: "idx_order_items_order")
}

model payments {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String          @db.Uuid
  user_id               String          @db.Uuid

  // Amounts
  amount                Decimal         @db.Decimal(15, 2)
  gateway_fee           Decimal         @default(0) @db.Decimal(15, 2)

  // Payment Info
  payment_method        String?         @db.VarChar(50)
  payment_gateway       String          @default("xendit") @db.VarChar(50)
  gateway_transaction_id String?        @db.VarChar(255)
  payment_url           String?

  // Status
  status                payment_status  @default(pending)

  // Timestamps
  expires_at            DateTime?       @db.Timestamptz(6)
  paid_at               DateTime?       @db.Timestamptz(6)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)

  orders                orders          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  users                 users           @relation(fields: [user_id], references: [id])

  @@index([order_id], map: "idx_payments_order")
  @@index([gateway_transaction_id], map: "idx_payments_gateway_tx")
  @@index([status], map: "idx_payments_status")
}

model refunds {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String          @db.Uuid
  refund_number     String          @unique @db.VarChar(50)
  amount            Decimal         @db.Decimal(15, 2)
  reason            String?
  status            refund_status   @default(pending)
  refunded_at       DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)

  orders            orders          @relation(fields: [order_id], references: [id])

  @@index([order_id], map: "idx_refunds_order")
}

// =============================================================================
// CART
// =============================================================================

model cart {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String      @db.Uuid
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)

  users       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cart_items  cart_items[]

  @@index([user_id], map: "idx_cart_user")
}

model cart_items {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id           String    @db.Uuid
  product_id        String?   @db.Uuid
  variant_id        String?   @db.Uuid
  seller_product_id String?   @db.Uuid
  brand_id          String?   @db.Uuid
  quantity          Int       @default(1)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  cart              cart      @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@index([cart_id], map: "idx_cart_items_cart")
}

// =============================================================================
// SHIPPING & LOGISTICS
// =============================================================================

model shipments {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String          @db.Uuid
  courier           String          @db.VarChar(50)
  service_type      String?         @db.VarChar(50)
  tracking_number   String?         @db.VarChar(100)
  shipping_cost     Decimal         @db.Decimal(15, 2)
  estimated_delivery DateTime?      @db.Timestamptz(6)
  status            shipment_status @default(pending)
  shipped_at        DateTime?       @db.Timestamptz(6)
  delivered_at      DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)

  orders            orders          @relation(fields: [order_id], references: [id])

  @@index([order_id], map: "idx_shipments_order")
  @@index([tracking_number], map: "idx_shipments_tracking")
}

// =============================================================================
// WALLET (For promotional credits, cashback)
// =============================================================================

model wallet {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @unique @db.Uuid
  balance           Decimal             @default(0) @db.Decimal(15, 2)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)

  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet_transactions wallet_transactions[]
}

model wallet_transactions {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id     String              @db.Uuid
  type          wallet_tx_type
  amount        Decimal             @db.Decimal(15, 2)
  balance_after Decimal             @db.Decimal(15, 2)
  description   String?
  reference     String?             @db.VarChar(255)
  metadata      Json?
  created_at    DateTime            @default(now()) @db.Timestamptz(6)

  wallet        wallet              @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id], map: "idx_wallet_tx_wallet")
  @@index([created_at], map: "idx_wallet_tx_created")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model notifications {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String              @db.Uuid
  type          String              @db.VarChar(50)
  title         String              @db.VarChar(255)
  message       String
  action_url    String?
  related_id    String?             @db.Uuid
  is_read       Boolean             @default(false)
  read_at       DateTime?           @db.Timestamptz(6)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)

  users         users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_notifications_user")
  @@index([is_read], map: "idx_notifications_read")
  @@index([created_at], map: "idx_notifications_created")
}

